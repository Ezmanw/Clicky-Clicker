[Unit]
Description=Clicky Clicker input remapping service
Documentation=https://github.com/Ezmanw/Clicky-Clicker

[Service]
Type=simple
ExecStart=@BINDIR@/clicky-clicker-daemon
Restart=on-failure
RestartSec=2

# The service reads /dev/input/event* and writes /dev/uinput. It needs no
# elevated privileges beyond the group membership that grants access to those,
# so it explicitly gives up the ability to acquire any.
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectKernelLogs=true
ProtectControlGroups=true
RestrictRealtime=true
RestrictSUIDSGID=true

# Needed for the macro library, the rotating log, and the control socket.
ReadWritePaths=%h/.config/clicky-clicker %h/.local/state/clicky-clicker
RuntimeDirectory=clicky-clicker
RuntimeDirectoryMode=0700

[Install]
WantedBy=default.target
